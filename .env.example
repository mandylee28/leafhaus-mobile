# Copy this file to .env and fill in your own values from your Supabase
# project: Dashboard > Settings > API > Project URL and anon key.
# Never put a real key in this file, and never commit .env.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
